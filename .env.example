# Grasi API Key
# 在 https://grsai.com 控制台获取
GRSAI_API_KEY=your_api_key_here

# Creem Payment
# 生产环境配置（Vercel 部署时在管理台配置）
CREEM_API_KEY=your_creem_api_key
CREEM_WEBHOOK_SECRET=your_webhook_secret
CREEM_PRODUCT_ID_100=prod_xxx
CREEM_PRODUCT_ID_200=prod_xxx
CREEM_PRODUCT_ID_500=prod_xxx
CREEM_BASE_URL=https://api.creem.io  # 生产: https://api.creem.io, 测试: https://test-api.creem.io

# Mock Payment Mode (仅本地开发使用)
# 设置为 'true' 可跳过 Creem API 调用，直接返回成功
MOCK_PAYMENT=false

# Proxy for Creem API (仅本地开发使用)
# 如果需要代理访问 Creem API，取消下面的注释
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897

# Supabase
# 在 Supabase 项目设置中获取: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google OAuth (配置在 Supabase 中)
# 在 Google Cloud Console 创建 OAuth 2.0 客户端 ID: https://console.cloud.google.com/
# 然后在 Supabase Dashboard > Authentication > Providers > Google 中配置
# 本地开发回调 URL: http://localhost:3000/auth/v1/callback
# 生产环境回调 URL: https://your-domain.com/auth/v1/callback
